#!/bin/bash

# Add the named packages to the system if they're missing. Returns false if it couldn't be done.
# Classifies packages into repo vs AUR and installs each group in a single batch.

if ! omarchy-pkg-missing "$@"; then
  exit 0  # All packages already installed
fi

# Classify packages into repo vs AUR
repo_pkgs=()
aur_pkgs=()

for pkg in "$@"; do
  # Skip if already installed (check both exact name and without -git suffix)
  if pacman -Q "$pkg" &>/dev/null || pacman -Q "${pkg%-git}" &>/dev/null; then
    continue
  fi

  # Check if available in repos (sync database)
  if pacman -Si "$pkg" &>/dev/null; then
    repo_pkgs+=("$pkg")
  else
    aur_pkgs+=("$pkg")
  fi
done

# Install repo packages in one batch
if [[ ${#repo_pkgs[@]} -gt 0 ]]; then
  echo "Installing from repos: ${repo_pkgs[*]}"
  sudo pacman -S --noconfirm --needed "${repo_pkgs[@]}"
fi

# Install AUR packages via yay in one batch
if [[ ${#aur_pkgs[@]} -gt 0 ]]; then
  if command -v yay &>/dev/null; then
    echo "Installing from AUR: ${aur_pkgs[*]}"
    yay -S --noconfirm --needed "${aur_pkgs[@]}"
  else
    echo -e "\033[33mWarning: AUR packages needed but yay not available: ${aur_pkgs[*]}\033[0m" >&2
  fi
fi

# Verify all packages installed
for pkg in "$@"; do
  if ! pacman -Q "$pkg" &>/dev/null && ! pacman -Q "${pkg%-git}" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
